<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.JiuzhentongzhiDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.JiuzhentongzhiEntity" id="jiuzhentongzhiMap">
        <result property="tongzhibianhao" column="tongzhibianhao"/>
        <result property="yishengzhanghao" column="yishengzhanghao"/>
        <result property="dianhua" column="dianhua"/>
        <result property="jiuzhenshijian" column="jiuzhenshijian"/>
        <result property="tongzhishijian" column="tongzhishijian"/>
        <result property="zhanghao" column="zhanghao"/>
        <result property="shouji" column="shouji"/>
        <result property="tongzhibeizhu" column="tongzhibeizhu"/>
        <result property="tongzhileixing" column="tongzhileixing"/>
        <result property="fasongzhuangtai" column="fasongzhuangtai"/>
        <result property="fasongshijian" column="fasongshijian"/>
        <result property="shibaiyuanyin" column="shibaiyuanyin"/>
        <result property="chongshicishu" column="chongshicishu"/>
        <result property="xiacichongshishijian" column="xiacichongshishijian"/>
        <result property="guanlianyuyueid" column="guanlianyuyueid"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.JiuzhentongzhiView" >

		SELECT  jiuzhentongzhi.* FROM jiuzhentongzhi  jiuzhentongzhi 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.JiuzhentongzhiView" >
		SELECT * FROM jiuzhentongzhi  jiuzhentongzhi <where> 1=1 ${ew.sqlSegment}</where>
	</select>

	<select id="selectValue" resultType="map" >
		SELECT ${params.xColumn}, ROUND(sum(${params.yColumn}),1) total FROM jiuzhentongzhi
		<where> 1=1 ${ew.sqlSegment}</where>
		group by ${params.xColumn}
		limit 10
	</select>

	<select id="selectTimeStatValue" resultType="map" >
		<if test = 'params.timeStatType == "日"'>
				SELECT DATE_FORMAT(${params.xColumn},'%Y-%m-%d') ${params.xColumn}, sum(${params.yColumn}) total FROM jiuzhentongzhi
				<where> 1=1 ${ew.sqlSegment}</where>
				group by DATE_FORMAT(${params.xColumn},'%Y-%m-%d')
		</if>
		<if test = 'params.timeStatType == "月"'>
				SELECT DATE_FORMAT(${params.xColumn},'%Y-%m') ${params.xColumn}, sum(${params.yColumn}) total FROM jiuzhentongzhi
				<where> 1=1 ${ew.sqlSegment}</where>
				group by DATE_FORMAT(${params.xColumn},'%Y-%m')
		</if>
		<if test = 'params.timeStatType == "年"'>
				SELECT DATE_FORMAT(${params.xColumn},'%Y') ${params.xColumn}, sum(${params.yColumn}) total FROM jiuzhentongzhi
				<where> 1=1 ${ew.sqlSegment}</where>
				group by DATE_FORMAT(${params.xColumn},'%Y')
		</if>
	</select>

	<select id="selectGroup" resultType="map" >
		SELECT ${params.column} , count(1) total FROM jiuzhentongzhi
		<where> 1=1 ${ew.sqlSegment}</where>
		group by ${params.column}
		limit 10
	</select>

</mapper>
